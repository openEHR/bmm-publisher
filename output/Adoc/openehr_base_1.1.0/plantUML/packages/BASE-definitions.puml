@startuml

class OPENEHR_DEFINITIONS {
  + {static} Local_terminology_id : String = "local" {readOnly}
}

class BASIC_DEFINITIONS {
  + {static} CR : Character = '\015' {readOnly}
  + {static} LF : Character = '\012' {readOnly}
  + {static} Any_type : String = "Any" {readOnly}
  + {static} Regex_any_pattern : String = ".*" {readOnly}
  + {static} Default_encoding : String = "UTF-8" {readOnly}
}

enum VALIDITY_KIND {
  mandatory 
  optional 
  prohibited 
}

enum VERSION_STATUS {
  alpha 
  beta 
  release_candidate 
  released 
  build 
}

BASIC_DEFINITIONS <|-- OPENEHR_DEFINITIONS

@enduml